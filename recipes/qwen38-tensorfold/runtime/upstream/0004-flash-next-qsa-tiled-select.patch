diff --git tensorfold/families/qwen4_exp/cuda/attention.py tensorfold/families/qwen4_exp/cuda/attention.py
index a61d34b..822a160 100644
--- tensorfold/families/qwen4_exp/cuda/attention.py
+++ tensorfold/families/qwen4_exp/cuda/attention.py
@@ -260,6 +260,67 @@ def _select(SC, POS0, IDS, NKR, SPR, NB, RATIO: tl.constexpr, TOP: tl.constexpr,
         tl.store(SPR + r, 1)
 
 
+@triton.jit
+def _select_tiles(SC, POS0, IDS, NKR, SPR, NB, RATIO: tl.constexpr, TOP: tl.constexpr, IDW: tl.constexpr,
+                  TILE: tl.constexpr):
+    """``_select``'s lists for long rows, read in tiles: the cut (the TOP-th largest key) by four 8-bit histogram passes
+    instead of 33 halvings over a whole row held in registers, then one pass listing the blocks; the same ids."""
+
+    r = tl.program_id(0)
+    end = tl.load(POS0) + r + 1
+    complete = end // RATIO
+    if complete <= TOP:
+        tl.store(NKR + r, end)
+        tl.store(SPR + r, 0)
+    else:
+        bins = tl.arange(0, 256)
+        prefix = tl.zeros((), dtype=tl.uint32)
+        need = TOP                                  # keys still wanted at or under the prefix
+        for level in tl.static_range(4):
+            shift = 24 - 8 * level
+            hist = tl.zeros((256,), dtype=tl.int32)
+            for t0 in range(0, complete, TILE):
+                b = t0 + tl.arange(0, TILE)
+                ok = b < complete
+                bits = tl.load(SC + r * NB + b, mask=ok, other=0.0).to(tl.uint32, bitcast=True)
+                key = tl.where((bits & 0x80000000) != 0, ~bits, bits | 0x80000000)
+                match = ok
+                if level > 0:
+                    match = ok & ((key >> (shift + 8)) == prefix)
+                hist += tl.histogram(((key >> shift) & 0xFF).to(tl.int32), 256, mask=match)
+            # the largest digit with at least ``need`` keys at or above it; the keys above it are all taken
+            atleast = tl.sum(hist, axis=0) - tl.cumsum(hist, axis=0) + hist
+            digit = tl.max(tl.where(atleast >= need, bins, 0), axis=0)
+            need = need - tl.sum(tl.where(bins > digit, hist, 0), axis=0)
+            prefix = (prefix << 8) | digit.to(tl.uint32)
+        cut = prefix
+        taken = 0                                   # keys equal to the cut listed so far (lower block ids first)
+        placed = 0
+        for t0 in range(0, complete, TILE):
+            b = t0 + tl.arange(0, TILE)
+            ok = b < complete
+            bits = tl.load(SC + r * NB + b, mask=ok, other=0.0).to(tl.uint32, bitcast=True)
+            key = tl.where((bits & 0x80000000) != 0, ~bits, bits | 0x80000000)
+            above = ok & (key > cut)
+            equal = ok & (key == cut)
+            rank = tl.cumsum(equal.to(tl.int32), axis=0) + taken
+            chosen = above | (equal & (rank <= need))
+            place = tl.cumsum(chosen.to(tl.int32), axis=0) - 1 + placed
+            for k in tl.static_range(RATIO):
+                tl.store(IDS + r * IDW + place * RATIO + k, b * RATIO + k, mask=chosen)
+            taken += tl.sum(equal.to(tl.int32), axis=0)
+            placed += tl.sum(chosen.to(tl.int32), axis=0)
+        t = tl.arange(0, RATIO)
+        tail = RATIO * complete + t
+        tl.store(IDS + r * IDW + TOP * RATIO + t, tail, mask=tail < end)
+        tl.store(NKR + r, TOP * RATIO + end - RATIO * complete)
+        tl.store(SPR + r, 1)
+
+
+SELECT_BLOCK = 32768        # past this many blocks a row's keys spill out of registers: select from tiles instead
+SELECT_TILE = 4096
+
+
 def qsa_select(iq: torch.Tensor, ikc: torch.Tensor, pooled: torch.Tensor, pos0: torch.Tensor, ik_scale: torch.Tensor,
                inv_freq: torch.Tensor, eps: float, scratch: AttnScratch, rows: int,
                *, context: int | None = None) -> None:
@@ -287,5 +348,9 @@ def qsa_rows(iq: torch.Tensor, pooled: torch.Tensor, pos0: torch.Tensor, scratch
     blocks = scratch.nb if context is None else min(scratch.nb, max(1, triton.cdiv(context, ratio)))
     _scores[(rows, triton.cdiv(blocks, bb))](iq, pooled, pos0, scratch.scores, scratch.nb, HI=iq.shape[1],
                                                  DI=di, RATIO=ratio, TOP=top, BB=bb, num_warps=4)
+    if triton.next_power_of_2(blocks) > SELECT_BLOCK:
+        _select_tiles[(rows,)](scratch.scores, pos0, scratch.ids, scratch.nk, scratch.sparse, scratch.nb,
+                               RATIO=ratio, TOP=top, IDW=scratch.idw, TILE=SELECT_TILE, num_warps=16)
+        return
     _select[(rows,)](scratch.scores, pos0, scratch.ids, scratch.nk, scratch.sparse, scratch.nb, RATIO=ratio,
                      TOP=top, IDW=scratch.idw, BLOCK=triton.next_power_of_2(blocks), num_warps=16)
