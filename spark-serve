def status_host(cfg: dict, host: str) -> str:
    names = " ".join(shlex.quote(n) for n in cfg["cluster"]["stop_names"])
    remote = f"""
docker ps -a --format '{{{{.Names}}}} {{{{.Status}}}}' | awk '$1 ~ /vllm/ {{print}}'
echo ---
for name in {names}; do
  docker inspect "$name" --format 'name={{{{.Name}}}} running={{{{.State.Running}}}} image={{{{.Config.Image}}}}' 2>/dev/null && break
done
"""
    return ssh_cmd(cfg, host, remote, check=False).stdout.strip()


def cmd_status(cfg: dict) -> None:
    c = cfg["cluster"]
    st = collect_status(cfg)
    print(f"head   {c['head']}  worker {c['worker']}  url {c['lan_url']}")
    print(f"-- {c['head']} --")
    print(status_host(cfg, c["head"]) or "(ssh failed)")
    print(f"-- {c['worker']} --")
    print(status_host(cfg, c["worker"]) or "(ssh failed)")
    print(f"mode: {st['mode']} · {st['phase']}")
    for worker in st["yue_workers"]:
        print(f"  YuE {worker['host']}: ready={worker['ready']} accepting={worker['accepting']} busy={worker['busy']}" + (f" ({worker['error']})" if worker.get("error") else ""))
    if st.get("transition_error"):
        print(f"transition: {st['transition_error']}")
    print("-- /v1/models --")
    print(st["v1_models_raw"] or "DOWN")
    if st["ready"]:
        print(f"ready: {st['served']}")
    else:
        print("ready: no")
    warn = foreign_warning(st)
    if warn:
        print(f"warning: {warn}")


def pick_log_container(cfg: dict, host: str) -> str:
    """Prefer a running vllm_* (or stop_names) container over the default name."""
    default = container_name(cfg)
    stop = [str(n) for n in (cfg["cluster"].get("stop_names") or [])]
    out = ssh_cmd(cfg, host, "docker ps --format '{{.Names}}'", check=False).stdout.strip()
    running = [ln.strip() for ln in out.splitlines() if ln.strip()]
    for n in running:
        if n.startswith("vllm_"):
            return n
    for n in stop:
        if n in running:
            return n
    return default


def cmd_logs(cfg: dict, follow: bool, which: str) -> None:
    host = cfg["cluster"]["head"] if which != "worker" else cfg["cluster"]["worker"]
    name = pick_log_container(cfg, host)
    flag = "-f --tail 80" if follow else "--tail 120"
    opts = list(cfg["cluster"].get("ssh_opts") or ["-o", "BatchMode=yes"])
    os.execvp("ssh", ["ssh", *opts, host, f"docker logs {flag} {shlex.quote(name)}"])


class _StartupMonitor:
    """Observe only IDs created by this launch; retain evidence before cleanup."""

    def __init__(self, cfg: dict, sink: _Sink):
        self.cfg, self.sink = cfg, sink
        self.containers: list[dict] = []

    def remember(self, host: str, rank: int, output: str) -> bool:
        ids = set(re.findall(
            rf"^(?:created|started) \S+ rank={rank} id=([0-9a-f]{{64}})$",
            output or "", re.MULTILINE,
        ))
        if len(ids) != 1:
            return False
        self.containers.append({"host": host, "rank": rank, "id": ids.pop()})
        return True

    def _inspect(self, container: dict) -> str | None:
        host, cid = container["host"], container["id"]
        proc = ssh_cmd(
            self.cfg, host,
            shlex.join(["docker", "inspect", "--type", "container", "--format", "{{json .State}}", cid]),
            check=False, timeout=15,
        )
        prefix = f"{host} rank {container['rank']} ({cid[:12]})"
        if proc.returncode:
            error = (proc.stderr or proc.stdout or f"exit {proc.returncode}").strip()[-1200:]
            if proc.returncode in (124, 255):
                return f"{prefix}: SSH unavailable; container state is unknown: {error}"
            if re.search(r"no such (?:object|container)", error, re.IGNORECASE):
                return f"{prefix}: launched container is missing"
            return f"{prefix}: cannot inspect container; state is unknown: {error}"
        try:
            state = json.loads(proc.stdout)
            if not isinstance(state, dict) or not isinstance(state.get("Running"), bool):
                raise ValueError("invalid Docker state")
        except (ValueError, TypeError):
            return f"{prefix}: invalid Docker state response; container state is unknown"
        container["state"] = state
        status = state.get("Status", "unknown")
        if (not state["Running"] or status != "running"
                or state.get("OOMKilled") or state.get("Restarting") or state.get("Paused")):
            error = str(state.get("Error") or "").strip()[:1200]
            return (
                f"{prefix}: startup failed (state={status}, exit={state.get('ExitCode', '?')}, "
                f"OOMKilled={bool(state.get('OOMKilled'))})" + (f": {error}" if error else "")
            )
        return None

    def check(self) -> None:
        with ThreadPoolExecutor(max_workers=max(1, len(self.containers))) as pool:
            failures = list(pool.map(self._inspect, self.containers))
        if any(failures):
            self.fail("; ".join(reason for reason in failures if reason))

    def _logs(self, container: dict) -> dict:
        # Bound remote output as well as local storage. IDs cannot follow a
        # replacement that reuses the same catalog container name.
        remote = "set -o pipefail\n" + shlex.join([
            "docker", "logs", "--timestamps", "--tail", "160", container["id"],
        ]) + " 2>&1 | tail -c 32768"
        proc = ssh_cmd(self.cfg, container["host"], remote, check=False, timeout=15)
        output = ((proc.stdout or "") + (proc.stderr or ""))[-32768:]
        return dict(container, log=output, log_exit_code=proc.returncode)

    def fail(self, reason: str) -> None:
        with ThreadPoolExecutor(max_workers=max(1, len(self.containers))) as pool:
            evidence = list(pool.map(self._logs, self.containers))
        report_path = None
        try:
            directory = state_dir() / "diagnostics"
            directory.mkdir(mode=0o700, parents=True, exist_ok=True)
            report_path = Path(tempfile.mkdtemp(prefix="startup-", dir=directory)) / "failure.json"
            report_path.write_text(json.dumps({
                "error": reason, "captured_at": time.time(), "containers": evidence,
            }, indent=2) + "\n")
        except OSError as exc:
            reason += f"; could not save startup diagnostics: {exc}"
        for item in evidence:
            self.sink.event(
                "startup_diagnostics", host=item["host"], rank=item["rank"],
                container_id=item["id"], output=item["log"],
                path=str(report_path) if report_path else None,
            )
        if report_path:
            reason += f"; startup diagnostics saved to {report_path}"
        # Controller.switch preserves this message and then performs its
        # existing generation-guarded cleanup of the partial launch.
        raise ControllerError(reason)



def wait_models(
    cfg: dict,
    timeout: int = 1500,
    expect_served: str | None = None,
    on_poll=None,
    check_started=None,
) -> tuple[bool, str | None, str]:
    catalog = catalog_served_names(cfg)
    t0 = time.monotonic()
    body = ""
    while time.monotonic() - t0 < timeout:
        if check_started:
            check_started()
        body = probe_v1(cfg, timeout=4)
        ids = parse_v1_ids(body)
        if expect_served:
            if expect_served in ids:
                if check_started:
                    check_started()
                return True, expect_served, body
        else:
            hit = next((i for i in ids if i in catalog), None)
            if hit:
                if check_started:
                    check_started()
                return True, hit, body
        elapsed = int(time.monotonic() - t0)
        if on_poll:
            on_poll(elapsed)
        else:
            print(f"  waiting for serve ({elapsed}s)…")
        time.sleep(15)
    return False, None, body


def wait_ready(
    cfg: dict,
    timeout: int = 1500,
    expect_served: str | None = None,
    ready_path: str = "/v1/models",
    on_poll=None,
    check_started=None,
) -> tuple[bool, str | None, str]:
    path = ready_path or "/v1/models"
    if path.rstrip("/") == "/v1/models":
        return wait_models(
            cfg, timeout=timeout, expect_served=expect_served, on_poll=on_poll,
            check_started=check_started,
        )
    url = cfg["cluster"]["lan_url"].rstrip("/") + path
    t0 = time.monotonic()
    body = ""
    while time.monotonic() - t0 < timeout:
        if check_started:
            check_started()
        proc = ssh_cmd(
            cfg,
            cfg["cluster"]["head"],
            f"curl -sf --max-time 4 {shlex.quote(url)}",
            check=False,
            timeout=14,
        )
        if proc.returncode == 0:
            body = probe_v1(cfg, timeout=4)
            ids = parse_v1_ids(body)
            served = expect_served if expect_served in ids else next((mid for mid in ids if mid in catalog_served_names(cfg)), None)
            if served and (not expect_served or served == expect_served):
                if check_started:
                    check_started()
                return True, served, body
        elapsed = int(time.monotonic() - t0)
        if on_poll:
            on_poll(elapsed)
        else:
            print(f"  waiting for serve ({elapsed}s)…")
        time.sleep(15)
    return False, None, body


def cmd_wait(cfg: dict) -> None:
    st = collect_status(cfg)
    warn = foreign_warning(st)
    if warn:
        print(f"note: {warn}; waiting for a catalog model")
    ok, served, body = wait_models(cfg)
    if not ok:
        die("timed out waiting for /v1/models")
    print(body)
    print(f"ready: {served}")


def _hermes_patch(cfg: dict, mid: str, model: dict, skip: bool) -> tuple[str, bool]:
    """Return (message, ok). ok=False means the patch did not apply."""
    if skip:
        return ("skipped (--no-hermes)", False)
    path = HERMES_CONFIG
    if not path.exists():
        return (f"no {path}, skipped", False)
    served = model["served_name"]
    provider = model.get("hermes_provider") or "spark"
    ctx = int(model.get("hermes_context_length") or model.get("max_model_len") or 0)
    url = cfg["cluster"]["lan_url"].rstrip("/") + "/v1"
    py = None
    for cand in (
        Path.home() / ".hermes/hermes-agent/venv/bin/python",
        shutil.which("python3"),
    ):
        if cand and Path(cand).exists():
            py = str(cand)
            break
    if not py:
        return ("no python, skipped", False)
    # Prefer ruamel.yaml so comments / key order in ~/.hermes/config.yaml survive.
    # omlx / GLM blocks are never deleted; only spark (+ leftover spark-ds4 url) move.
    patch = f"""
import sys
from pathlib import Path
p = Path({str(path)!r})
text = p.read_text()
engine = None
yaml_obj = None
try:
    from ruamel.yaml import YAML
    yaml_obj = YAML()
    yaml_obj.preserve_quotes = True
    yaml_obj.width = 4096
    data = yaml_obj.load(text) or {{}}
    engine = 'ruamel'
except Exception:
    try:
        import yaml as pyyaml
        data = pyyaml.safe_load(text) or {{}}
        yaml_obj = pyyaml
        engine = 'pyyaml'
    except ImportError:
        print('NO_YAML')
        sys.exit(2)
model = data.setdefault('model', {{}})
model['default'] = {served!r}
model['provider'] = {provider!r}
if {ctx}:
    model['context_length'] = {ctx}
providers = data.setdefault('providers', {{}})
block = providers.setdefault({provider!r}, {{}})
block['name'] = 'Spark cluster'
block['api_key'] = block.get('api_key') or 'dummy'
block['api_mode'] = block.get('api_mode') or 'chat_completions'
block['base_url'] = {url!r}
block['default_model'] = {served!r}
models = block.setdefault('models', {{}})
models[{served!r}] = {{'context_length': {ctx} or 8192}}
if 'spark-ds4' in providers and {provider!r} != 'spark-ds4':
    providers['spark-ds4']['base_url'] = {url!r}
if engine == 'ruamel':
    with p.open('w') as f:
        yaml_obj.dump(data, f)
else:
    p.write_text(yaml_obj.safe_dump(data, sort_keys=False, default_flow_style=False))
print('patched', p, 'via', engine, 'provider', {provider!r}, 'model', {served!r}, 'ctx', {ctx})
"""
    proc = subprocess.run([py, "-c", patch], text=True, capture_output=True, check=False)
    msg = (proc.stdout or proc.stderr or "").strip()
    if proc.returncode != 0:
        return (f"not patched ({msg or proc.returncode})", False)
    return (msg, True)


def maybe_hermes(cfg: dict, mid: str, model: dict, skip: bool) -> None:
    msg, _ = _hermes_patch(cfg, mid, model, skip)
    print(f"hermes: {msg}")


def maybe_hermes_json(cfg: dict, mid: str, model: dict, skip: bool) -> str:
    msg, _ = _hermes_patch(cfg, mid, model, skip)
    return msg


def cmd_pull(cfg: dict, name: str) -> None:
    mid, model = resolve_model(cfg, name)
    image = model["image"]
    repos = [model["hf_id"], *[str(x) for x in (model.get("pull_repos") or [])]]
    print(f"pull {mid}: image {image}")
    for rid in repos:
        print(f"pull {mid}: weights {rid}")
    xet = "" if model.get("keep_xet") else "HF_HUB_DISABLE_XET=1 "
    hf_cmds = []
    for rid in repos:
        q = shlex.quote(rid)
        hf_cmds.append(f'echo "== hf download {q} =="')
        hf_cmds.append(f'"$HF" download {q}')
    hf_lines = "\n".join(hf_cmds)
    remote = f"""
set -euo pipefail
echo "== docker pull {image} =="
docker pull {shlex.quote(image)}
export {xet}HF_HUB_DISABLE_IMPLICIT_TOKEN=1 HF_HUB_ENABLE_HF_TRANSFER=0 HF_TOKEN=
if command -v hf >/dev/null 2>&1; then
  HF=hf
elif [ -x "$HOME/miniconda3/bin/hf" ]; then
  HF="$HOME/miniconda3/bin/hf"
elif [ -x "$HOME/.local/bin/hf" ]; then
  HF="$HOME/.local/bin/hf"
else
  echo "no hf CLI"; exit 1
fi
{hf_lines}
echo DONE
"""
    for host in (cfg["cluster"]["worker"], cfg["cluster"]["head"]):
        print(f"-- {host} --")
        proc = ssh_cmd(cfg, host, remote, check=False)
        sys.stdout.write(proc.stdout or "")
        if proc.returncode != 0:
            sys.stderr.write(proc.stderr or "")
            die(f"pull failed on {host}")


def _emit(event: str, **fields) -> None:
    obj = {"event": event}
    obj.update(fields)
    print(json.dumps(obj), flush=True)


class _Sink:
    def __init__(self, json_mode: bool):
        self.json_mode = json_mode

    def event(self, name: str, **fields) -> None:
        if self.json_mode:
            _emit(name, **fields)
            return
        if name == "start":
            print(f"up {fields.get('model')} ({fields.get('label')})")
            print(f"  image  {fields.get('image')}")
            print(f"  served {fields.get('served')}  ctx {fields.get('ctx')}")
            print(f"  url    {fields.get('url')}")
        elif name == "stop":
            print(f"  stop {fields.get('host')}: {fields.get('output')}")
        elif name == "drop_caches":
            print(f"  drop_caches {fields.get('host')}: {fields.get('output')}")
        elif name == "worker_ready":
            print(f"YuE ready {fields.get('host')}: {fields.get('ready_workers')}/{fields.get('total_workers')}")
        elif name == "worker_start":
            print(f"start worker {fields.get('host')}")
            if fields.get("output"):
                print(fields["output"])
        elif name == "head_start":
            print(f"start head {fields.get('host')} rank 0")
            if fields.get("output"):
                print(fields["output"])
        elif name == "hermes":
            print(f"hermes: {fields.get('detail')}")
        elif name == "waiting":
            print("boot takes ~10–25 min (Triton JIT on Qwen is the long one).")
            print("  spark-serve status")
            print("  spark-serve logs -f")
            if fields.get("hermes_hint"):
                print(f"  hermes  ({fields['hermes_hint']})")
            path = fields.get("ready_path") or "/v1/models"
            print(f"waiting for {path} …")
        elif name == "poll":
            print(f"  waiting for serve ({fields.get('elapsed', 0)}s)…")
        elif name == "startup_diagnostics":
            print(f"-- startup log {fields.get('host')} rank {fields.get('rank')} --", flush=True)
            print(fields.get("output") or "(no logs available)", flush=True)
            if fields.get("path"):
                print(f"diagnostics: {fields['path']}", flush=True)
        elif name == "ready":
            if fields.get("body"):
                print(fields["body"])
            print("ready")
        elif name == "launched":
            print("launched (--no-wait)")
        elif name == "timeout":
            path = fields.get("ready_path") or "/v1/models"
            die(f"containers started but {path} never came up — spark-serve logs")
        elif name == "error":
            die(fields.get("detail") or "error")

    def fail(self, msg: str, code: int = 1) -> None:
        if self.json_mode:
            _emit("error", detail=msg)
        else:
            print(f"spark-serve: {msg}", file=sys.stderr)
        raise SystemExit(code)


def _bring_up(
    cfg: dict,
    name: str,
    no_hermes: bool,
    no_wait: bool,
    sink: _Sink,
    print_cmd: bool = False,
    generation: str | None = None,
) -> None:
    mid, model = resolve_model(cfg, name)
    c = cfg["cluster"]
    nnodes = int(model.get("nnodes") or c["nnodes"])
    if print_cmd:
        ranks = [(0, False, "head/rank0")]
        if nnodes > 1:
            ranks.append((1, True, "worker/rank1"))
        for rank, headless, label in ranks:
            print(f"===== {label} name={container_name(cfg, model)} =====")
            print(docker_run_script(cfg, model, rank, headless), end="")
        return
    sink.event(
        "start",
        model=mid,
        label=model.get("label") or mid,
        image=model["image"],
        served=model["served_name"],
        ctx=int(model.get("max_model_len") or 0),
        url=c["lan_url"] + "/v1",
        nnodes=nnodes,
    )
    # The cross-backend controller already drained and verified both GPUs.
    ids = parse_v1_ids(probe_v1(cfg))
    if ids:
        who = ids[0]
        sink.fail(
            f":8000 still serving {who} after stop "
            "(not a docker container we could remove)"
        )
    if model.get("drop_caches", True):
        hosts = (c["head"],) if nnodes == 1 else (c["worker"], c["head"])
        for host in hosts:
            sink.event("drop_caches", host=host, output=drop_caches(cfg, host))
    monitor = _StartupMonitor(cfg, sink)
    if nnodes > 1:
        worker_script = docker_run_script(cfg, model, 1, True)
        if generation:
            worker_script = guarded_remote_script(generation, worker_script)
        w = ssh_cmd(cfg, c["worker"], worker_script, check=False)
        worker_id_known = monitor.remember(c["worker"], 1, w.stdout)
        if w.returncode != 0:
            monitor.fail(f"{c['worker']}: worker launch failed: {(w.stderr or w.stdout or '').strip()[-1200:] or f'exit {w.returncode}'}")
        if not worker_id_known:
            monitor.fail(f"{c['worker']}: worker launch returned no unambiguous immutable container ID")
        sink.event("worker_start", host=c["worker"], output=(w.stdout or "").strip())
        # Give the worker a moment to bind the torch.distributed master port.
        time.sleep(8)
    else:
        sink.event("worker_start", host=c["worker"], output="skipped (model nnodes=1)")
    head_script = docker_run_script(cfg, model, 0, False)
    if generation:
        head_script = guarded_remote_script(generation, head_script)
    h = ssh_cmd(cfg, c["head"], head_script, check=False)
    head_id_known = monitor.remember(c["head"], 0, h.stdout)
    if h.returncode != 0:
        monitor.fail(f"{c['head']}: head launch failed: {(h.stderr or h.stdout or '').strip()[-1200:] or f'exit {h.returncode}'}")
    if not head_id_known:
        monitor.fail(f"{c['head']}: head launch returned no unambiguous immutable container ID")
    sink.event("head_start", host=c["head"], output=(h.stdout or "").strip())
    if no_wait:
        sink.event("hermes", detail="skipped (--no-wait)")
        sink.event("launched")
        return
    hint = f"provider {model.get('hermes_provider', 'spark')}, -m {model['served_name']}"
    ready_path = model.get("ready_path") or "/v1/models"
    sink.event("waiting", hermes_hint=hint, ready_path=ready_path)
    t0 = time.time()
    ok, served, body = wait_ready(
        cfg,
        expect_served=model["served_name"],
        ready_path=ready_path,
        on_poll=lambda elapsed: sink.event("poll", elapsed=elapsed),
        check_started=monitor.check,
    )
    if ok:
        hermes = maybe_hermes_json(cfg, mid, model, skip=no_hermes)
        sink.event("hermes", detail=hermes)
        sink.event("ready", served=served, elapsed=int(time.time() - t0), body=body)
        return
    sink.event("hermes", detail="skipped (wait failed)")
    monitor.fail(f"containers started but {ready_path} did not become ready before the startup timeout")


def cmd_up(
    cfg: dict,
    name: str,
    no_hermes: bool,
    no_wait: bool,
    json_mode: bool,
    print_cmd: bool = False,
    cancel_jobs: bool = False,
) -> None:
    sink = _Sink(json_mode)
    yue = name.strip().lower() in ("yue", "yue-icl")
    if print_cmd:
        if yue:
            print("YuE uses managed systemd workers; no distributed vLLM command is generated.")
        else:
            _bring_up(cfg, name, no_hermes, no_wait, sink, print_cmd=True)
        return
    if yue and no_wait:
        sink.fail("YuE requires admission verification before publishing workers; omit --no-wait")
    if not yue:
        resolve_model(cfg, name)  # Reject invalid names before touching live workloads.
    try:
        Controller(cfg, ssh_cmd, sink.event).switch(
            "yue" if yue else name,
            lambda generation: _bring_up(cfg, name, no_hermes, no_wait, sink, generation=generation),
            cancel_jobs=cancel_jobs, no_wait=no_wait,
        )
    except ControllerError as exc:
        sink.fail(str(exc))


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="spark-serve",
        description="Manage vLLM cluster recipes and two independent YuE workers.",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    lst = sub.add_parser("list", help="show catalog")
    lst.add_argument("--json", action="store_true", help="emit catalog as JSON")

    st = sub.add_parser("status", help="containers + /v1/models")
    st.add_argument("--json", action="store_true", help="emit status as JSON")

    stop = sub.add_parser("stop", help="drain and stop all managed workloads, retain protected containers")
    stop.add_argument("--cancel-jobs", action="store_true", help="explicitly cancel active YuE jobs before stopping")
    sub.add_parser("wait", help="block until a catalog model answers /v1/models")

    up = sub.add_parser("up", help="stop current serve, start a catalog model")
    up.add_argument("model")
    up.add_argument("--cancel-jobs", action="store_true", help="explicitly cancel active YuE jobs before switching modes")
    up.add_argument("--no-hermes", action="store_true", help="do not retarget ~/.hermes/config.yaml")
    up.add_argument("--no-wait", action="store_true", help="do not block on the ready probe")
    up.add_argument("--json", action="store_true", help="emit JSON-line progress events")
    up.add_argument("--print-cmd", action="store_true", help=argparse.SUPPRESS)

    pull = sub.add_parser("pull", help="docker pull + hf download on both Sparks")
    pull.add_argument("model")

    logs = sub.add_parser("logs", help="docker logs on head (or worker)")
    logs.add_argument("-f", "--follow", action="store_true")
    logs.add_argument("which", nargs="?", default="head", choices=["head", "worker"])
    return p


def main(argv: list[str] | None = None) -> None:
    global _JSON_MODE
    args = build_parser().parse_args(argv)
    cfg = load()
    if args.cmd == "list":
        if args.json:
            cmd_list_json(cfg)
        else:
            cmd_list(cfg)
    elif args.cmd == "status":
        if args.json:
            cmd_status_json(cfg)
        else:
            cmd_status(cfg)
    elif args.cmd == "stop":
        cmd_stop(cfg, cancel_jobs=args.cancel_jobs)
    elif args.cmd == "wait":
        cmd_wait(cfg)
    elif args.cmd == "up":
        _JSON_MODE = bool(args.json)
        cmd_up(
            cfg,
            args.model,
            no_hermes=args.no_hermes,
            no_wait=args.no_wait,
            json_mode=_JSON_MODE,
            print_cmd=bool(args.print_cmd),
            cancel_jobs=args.cancel_jobs,
        )
    elif args.cmd == "pull":
        cmd_pull(cfg, args.model)
    elif args.cmd == "logs":
        cmd_logs(cfg, args.follow, args.which)
    else:
        die(f"unhandled {args.cmd}")


if __name__ == "__main__":
    main()
