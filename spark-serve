HERE = Path(__file__).resolve().parent
CATALOG = HERE / "models.toml"
EXAMPLE = HERE / "models.example.toml"
HERMES_CONFIG = Path.home() / ".hermes" / "config.yaml"

# When True, die() emits a JSON-line error event (used by `up --json`).
_JSON_MODE = False


def die(msg: str, code: int = 1) -> None:
    if _JSON_MODE:
        _emit("error", detail=msg)
    else:
        print(f"spark-serve: {msg}", file=sys.stderr)
    raise SystemExit(code)


def load() -> dict:
    if not CATALOG.exists():
        hint = f"copy {EXAMPLE.name} to {CATALOG.name} and edit [cluster]" if EXAMPLE.exists() else f"create {CATALOG}"
        die(f"missing catalog {CATALOG} — {hint}")
    with CATALOG.open("rb") as f:
        return tomllib.load(f)


def resolve_model(cfg: dict, name: str) -> tuple[str, dict]:
    models = cfg.get("models") or {}
    key = name.strip().lower()
    if key in models:
        return key, models[key]
    for mid, m in models.items():
        aliases = [a.lower() for a in m.get("aliases") or []]
        if key in aliases or key == str(m.get("served_name", "")).lower():
            return mid, m
    known = ", ".join(sorted(models))
    die(f"unknown model {name!r}. catalog: {known}")


def ssh_cmd(
    cfg: dict,
    host: str,
    remote: str,
    check: bool = True,
    timeout: int = 660,
) -> subprocess.CompletedProcess:
    opts = list(cfg["cluster"].get("ssh_opts") or ["-o", "BatchMode=yes"])
    try:
        proc = subprocess.run(
            ["ssh", *opts, "-o", "ConnectTimeout=8", host, "bash", "-s"],
            input=remote, text=True, capture_output=True, timeout=timeout, check=False,
        )
    except subprocess.TimeoutExpired:
        proc = subprocess.CompletedProcess([], 124, "", "SSH operation timed out; remote ownership requires reconciliation")
    if check and proc.returncode != 0:
        err = (proc.stderr or proc.stdout or "").strip()
        die(f"{host}: {err or f'exit {proc.returncode}'}")
    return proc


def ssh_out(cfg: dict, host: str, remote: str) -> str:
    return ssh_cmd(cfg, host, remote).stdout


def env_pairs(cfg: dict, model: dict) -> list[tuple[str, str]]:
    pairs: list[tuple[str, str]] = []
    for k, v in (cfg["cluster"].get("nccl") or {}).items():
        pairs.append((str(k), str(v)))
    for k, v in (model.get("env") or {}).items():
        pairs.append((str(k), str(v)))
    return pairs


def container_name(cfg: dict, model: dict | None = None) -> str:
    if model and model.get("container"):
        return str(model["container"])
    return str(cfg["cluster"].get("container") or "vllm_cluster")


def docker_base(cfg: dict, model: dict, name: str, rank: int = 0) -> list[str]:
    cluster = cfg["cluster"]
    shm = str(model.get("shm_size") or "10g")
    cmd = [
        "docker", "create",
        "--name", name,
        "--privileged",
        "--network", "host",
        "--ipc", "host",
        "--shm-size", shm,
        "--gpus", "all",
        "--security-opt", "label=disable",
    ]
    if not model.get("skip_default_cache_mount"):
        cache = cluster["hf_cache_host"]
        mount = model.get("hf_mount") or "/cache/huggingface"
        cmd.extend(["-v", f"{cache}:{mount}"])
    for mnt in model.get("mounts") or []:
        if not isinstance(mnt, dict):
            continue
        cpath = mnt.get("container")
        hpath = mnt.get("head") if rank == 0 else mnt.get("worker")
        if not cpath or not hpath:
            continue
        spec = f"{hpath}:{cpath}"
        if mnt.get("readonly") or mnt.get("ro"):
            spec += ":ro"
        cmd.extend(["-v", spec])
    cmd.extend([
        "--device", "/dev/infiniband",
        "-w", "/tmp",
    ])
    extra = model.get("docker_extra") or []
    if isinstance(extra, str):
        extra = shlex.split(extra)
    cmd.extend(extra)
    for k, v in env_pairs(cfg, model):
        cmd.extend(["-e", f"{k}={v}"])
    host_ip = model.get("host_ip_head") if rank == 0 else model.get("host_ip_worker")
    if host_ip:
        cmd.extend(["-e", f"VLLM_HOST_IP={host_ip}"])
    return cmd


def rank_flags(cfg: dict, rank: int, headless: bool, model: dict | None = None) -> list[str]:
    c = cfg["cluster"]
    m = model or {}
    nnodes = int(m.get("nnodes") or c["nnodes"])
    flags = [
        "--nnodes", str(nnodes),
        "--node-rank", str(rank),
        "--master-addr", str(m.get("master_addr") or c["master_addr"]),
        "--master-port", str(m.get("master_port") or c["master_port"]),
        "--distributed-executor-backend", str(c.get("executor") or "mp"),
    ]
    if headless:
        flags.append("--headless")
    return flags


def vllm_args(cfg: dict, model: dict) -> list[str]:
    block = model.get("vllm") or {}
    args = [str(a) for a in (block.get("args") or [])]
    # Prefer per-model tensor_parallel when injecting the default flag.
    tp = model.get("tensor_parallel")
    if tp is None:
        tp = cfg["cluster"].get("tensor_parallel")
    if tp is not None and "--tensor-parallel-size" not in args:
        args.extend(["--tensor-parallel-size", str(tp)])
    return args


def inner_argv(cfg: dict, model: dict, rank: int, headless: bool) -> list[str]:
    wrapper = model.get("wrapper") or "vllm"
    serve = model.get("serve_path") or model["hf_id"]
    args = vllm_args(cfg, model) + rank_flags(cfg, rank, headless, model)
    if wrapper == "dsv4":
        return ["serve", serve, *args]
    if wrapper in ("vllm", "dsv4-vision"):
        # dsv4-vision: same argv shape as stock vllm; entrypoint cleared in docker_run_script.
        return [serve, *args]
    die(f"unknown wrapper {wrapper!r} (use dsv4, vllm, or dsv4-vision)")


def docker_run_script(cfg: dict, model: dict, rank: int, headless: bool) -> str:
    name = container_name(cfg, model)
    image = model["image"]
    wrapper = model.get("wrapper") or "vllm"
    argv = inner_argv(cfg, model, rank, headless)
    base = docker_base(cfg, model, name, rank)
    if wrapper == "dsv4":
        # Image ENTRYPOINT is not `vllm`; wrap the proven dsv4 helper.
        inner = "exec /usr/local/bin/dsv4-vllm-entrypoint " + " ".join(
            shlex.quote(a) for a in argv
        )
        full = base + [image, "bash", "-lc", inner]
    elif wrapper == "dsv4-vision":
        # FlyCockpit / Anemll image: clear ENTRYPOINT, reinstall editable plugin
        # from the bind-mount, then serve the symlink tree.
        serve_argv = " ".join(shlex.quote(a) for a in ["serve", *argv])
        inner = (
            "set -euo pipefail; "
            "python3 -m pip install -e /opt/dsv4-vision-plugin --no-deps -q; "
            "exec /usr/local/bin/vllm " + serve_argv
        )
        full = base + ["--entrypoint", "bash", image, "-lc", inner]
    else:
        full = base + [image, *argv]
    # Create is CPU-only. Starting an immutable ID is a separate guarded action:
    # a delayed old create cannot launch a GPU workload or revive a removed ID.
    start = '''import json, os, pathlib, subprocess, sys
root = pathlib.Path(os.environ.get("SPARK_SERVE_NODE_STATE_DIR", "~/.local/state/spark-serve")).expanduser()
generation = os.environ.get("SPARK_SERVE_NODE_GENERATION")
try: state = json.loads((root / "node.json").read_text())
except (OSError, ValueError): state = {}
if not generation or state.get("generation") != generation:
    sys.stderr.write("stale remote controller generation; container was created but not started")
    raise SystemExit(75)
lock_fd = os.environ.get("SPARK_SERVE_NODE_LOCK_FD")
if lock_fd is None:
    sys.stderr.write("missing node ownership lock; container was not started")
    raise SystemExit(75)
result = subprocess.run(["docker", "start", sys.argv[1]], pass_fds=(int(lock_fd),), check=False)
raise SystemExit(result.returncode)
'''
    return (
        "set -euo pipefail\n"
        + "container_id=$(" + shlex.join(full) + ")\n"
        + f'echo created $(hostname) rank={rank} id="$container_id"\n'
        + shlex.join(["python3", "-c", start]) + ' "$container_id"\n'
        + f'echo started $(hostname) rank={rank} id="$container_id"\n'
    )


def drop_caches(cfg: dict, host: str) -> str:
    proc = ssh_cmd(
        cfg,
        host,
        'if sudo -n true 2>/dev/null; then sudo -n sh -c "sync; echo 3 > /proc/sys/vm/drop_caches"; echo dropped; else echo skip_no_sudo; fi',
        check=False,
    )
    return (proc.stdout or "").strip() or "skip"


def catalog_served_names(cfg: dict) -> set[str]:
    names: set[str] = set()
    for m in (cfg.get("models") or {}).values():
        served = str(m.get("served_name") or "").strip()
        if served:
            names.add(served)
    return names


def parse_v1_ids(body: str) -> list[str]:
    if not body or body in ("DOWN",):
        return []
    try:
        data = json.loads(body)
    except json.JSONDecodeError:
        return []
    ids = []
    for m in data.get("data") or []:
        mid = m.get("id")
        if mid:
            ids.append(str(mid))
    return ids


def probe_v1(cfg: dict, timeout: int = 5) -> str:
    url = cfg["cluster"]["lan_url"].rstrip("/") + "/v1/models"
    return ssh_cmd(
        cfg,
        cfg["cluster"]["head"],
        f"curl -sf --max-time {int(timeout)} {shlex.quote(url)} || true",
        check=False,
        timeout=timeout + 10,
    ).stdout.strip()


def _container_running(state: str) -> bool:
    st = (state or "").strip().lower()
    return st == "running" or st.startswith("up")


def status_host_json(cfg: dict, host: str) -> list:
    remote = "docker ps -a --format '{{.Names}}|||{{.State}}|||{{.Image}}'"
    out = ssh_cmd(cfg, host, remote, check=False).stdout.strip()
    containers = []
    for line in out.splitlines():
        if "|||" not in line:
            continue
        parts = line.split("|||")
        if len(parts) != 3:
            continue
        name, state, image = (p.strip() for p in parts)
        owned_names = {container_name(cfg), *(cfg["cluster"].get("stop_names") or [])}
        owned_names.update(str(m["container"]) for m in (cfg.get("models") or {}).values() if m.get("container"))
        if name in owned_names or "vllm" in name.lower():
            containers.append({
                "name": name,
                "state": state,
                "image": image,
                "running": _container_running(state),
            })
    return containers


def collect_status(cfg: dict) -> dict:
    c = cfg["cluster"]
    name = str(c.get("container") or "vllm_cluster")
    nnodes = int(c.get("nnodes") or 1)
    head_c = status_host_json(cfg, c["head"])
    worker_c = status_host_json(cfg, c["worker"])
    body = probe_v1(cfg)
    ids = parse_v1_ids(body)
    served = ids[0] if ids else None
    catalog = catalog_served_names(cfg)
    in_catalog = bool(served) and served in catalog
    matching = [m for m in (cfg.get("models") or {}).values() if m.get("served_name") == served]
    if len(matching) == 1:
        nnodes = int(matching[0].get("nnodes") or nnodes)
        name = container_name(cfg, matching[0])

    def is_ours(x: dict) -> bool:
        n = x["name"]
        return bool(x["running"] and n == name)

    head_ours = any(is_ours(x) for x in head_c)
    worker_ours = any(is_ours(x) for x in worker_c)
    ours_running = head_ours and (worker_ours if nnodes > 1 else True)
    vllm_running = any(x["running"] for x in head_c + worker_c)
    port_busy = bool(ids)
    # Occupant of :8000 that is not our vLLM set is foreign even if the
    # served id happens to match a catalog name.
    if port_busy and not vllm_running:
        foreign = served or "unknown"
    elif served and not in_catalog:
        foreign = served
    else:
        foreign = None
    result = {
        "head": c["head"],
        "worker": c["worker"],
        "url": c["lan_url"],
        "head_containers": head_c,
        "worker_containers": worker_c,
        "ready": bool(ours_running and in_catalog),
        "served": served,
        "foreign_served": foreign,
        "ours_running": ours_running,
        "vllm_running": vllm_running,
        "port_busy": port_busy,
        "v1_models_raw": body,
    }
    managed = Controller(cfg, ssh_cmd).status()
    result.update(managed)
    if managed["mode"] == "yue":
        result["ready"] = managed["phase"] == "ready" and managed["ready_workers"] == managed["total_workers"]
        result["served"] = "yue" if result["ready"] else None
        result["url"] = " · ".join(w["url"] for w in managed["yue_workers"])
    elif managed["phase"] in ("draining", "stopping", "failed"):
        result["ready"] = False
    return result


def foreign_warning(st: dict) -> str | None:
    if not st.get("port_busy"):
        return None
    if st.get("ours_running") and not st.get("foreign_served"):
        return None
    who = st.get("foreign_served") or st.get("served") or "unknown"
    if st.get("vllm_running"):
        return None
    return f":8000 serving {who} (not a spark-serve container)"


def cmd_stop(cfg: dict, cancel_jobs: bool = False) -> None:
    sink = _Sink(False)
    try:
        Controller(cfg, ssh_cmd, sink.event).switch("none", cancel_jobs=cancel_jobs)
    except ControllerError as exc:
        die(str(exc))
    print("stopped; protected containers retained", flush=True)


