#!/usr/bin/env python3
"""Mac-side launcher for a two-node NVIDIA DGX Spark vLLM cluster.

Add a model by dropping a [models.<id>] table in models.toml next to this
script. Copy models.example.toml to models.toml and edit [cluster].
Do not retune NCCL here. Never stop names in cluster.keep_containers.
"""
from __future__ import annotations

